{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2020",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["es2020"],
    "moduleResolution": "node"
  },
  "compileOnSave": true,
  "include": ["src", "index.ts"]
}
