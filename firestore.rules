rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function serverOwnedUserFields() {
      return [
        'isPremium',
        'planName',
        'subscription',
        'onboardingCompleted',
        'answersSubmitted',
        'deletionRequestedAt'
      ];
    }

    function isFreshUser(data) {
      return !data.keys().hasAny([
          'isPremium',
          'planName',
          'subscription',
          'deletionRequestedAt'
        ])
        && data.get('onboardingCompleted', false) == false
        && data.get('answersSubmitted', false) == false;
    }

    function touchesServerFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(serverOwnedUserFields());
    }

    function hasValidClock(data) {
      return !('utcOffsetMinutes' in data)
        || (data.utcOffsetMinutes is int
          && data.utcOffsetMinutes >= -720
          && data.utcOffsetMinutes <= 840);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isFreshUser(request.resource.data)
        && hasValidClock(request.resource.data);
      allow update: if isOwner(uid)
        && !touchesServerFields()
        && hasValidClock(request.resource.data);

      match /invoices/{invoiceId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /daily_flow/{dayId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /stats/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /targets/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /food_logs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /custom_foods/{foodId} {
        allow read, write: if isOwner(uid);
      }

      match /food_images/{imageId} {
        allow read, delete: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.url is string
          && request.resource.data.url.size() < 2048;
      }

      match /water_logs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /weight_logs/{logId} {
        allow read, write: if isOwner(uid);
      }

      match /workout_sessions/{sessionId} {
        allow read, write: if isOwner(uid);
      }

      match /workout_state/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /workout_exercises/{exerciseId} {
        allow read, write: if isOwner(uid);
      }

      match /workout_programs/{programId} {
        allow read, write: if isOwner(uid);
      }

      match /workout_plans/{planId} {
        allow read, write: if isOwner(uid);
      }

      match /habits/{habitId} {
        allow read, write: if isOwner(uid);
      }

      match /habit_logs/{dayId} {
        allow read, write: if isOwner(uid);
      }

      match /health_logs/{dayId} {
        allow read, write: if isOwner(uid);
      }

      match /progress/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /wave_messages/{messageId} {
        allow read, write: if isOwner(uid);
      }

      match /wave_days/{dayId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /integrations/{provider} {
        allow read, write: if false;
      }
    }

    match /onboarding_details/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
